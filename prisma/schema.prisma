// Data model is sport-agnostic: every sport-specific vocabulary (age levels,
// focus areas, surfaces, equipment, player roles) lives in rows, not code.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// A coach's login. Teams, plans, coaches, locations and private drills
// belong to a user; library drills (ownerId null) are shared by everyone.
model User {
  id            String        @id @default(cuid())
  email         String        @unique
  name          String
  passwordHash  String
  // COACH | ADMIN. Admins review submitted drills and manage the library.
  role          String        @default("COACH")
  defaultSport  String        @default("")
  driveFolderId String        @default("")
  sessions      UserSession[]
  teams         Team[]
  plans         Plan[]
  coaches       Coach[]
  locations     Location[]
  drills        Drill[]       @relation("OwnedDrills")
  submissions   Drill[]       @relation("SubmittedDrills")
  createdAt     DateTime      @default(now())
}

model UserSession {
  id        String   @id @default(cuid())
  // sha256 of the cookie value, so a leaked database can't be replayed.
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Sport {
  id       String  @id @default(cuid())
  slug     String  @unique
  name     String
  // Tags are shared by every sport with the same tagGroup (baseball and
  // softball both use "diamond"), plus tags in the "global" group.
  tagGroup String
  // SportConfig JSON: player roles, side-work pairing, block template.
  config   Json
  drills   Drill[]
  teams    Team[]
  plans    Plan[]
}

// kind: AGE | SKILL | FOCUS | SURFACE | EQUIPMENT
model Tag {
  id        String  @id @default(cuid())
  kind      String
  slug      String
  label     String
  group     String  @default("global")
  sortOrder Int     @default(0)
  drills    Drill[]

  @@unique([kind, slug, group])
}

model Drill {
  id              String       @id @default(cuid())
  name            String
  // WARMUP | THROWING | DAILY | STATION | SIDE_WORK | TEAM | GAME | TALK
  blockType       String
  description     String       @default("")
  // Newline-separated bullet points that are copied into the plan.
  instructions    String       @default("")
  durationMin     Int          @default(5)
  durationTypical Int          @default(10)
  durationMax     Int          @default(15)
  coachesRequired Int          @default(1)
  minPlayers      Int          @default(1)
  maxPlayers      Int?
  // Free-form provenance, e.g. "Coach plans 2024-2026" or "needs review".
  source          String       @default("")
  // Null means the drill is in the shared library. Otherwise only the owner
  // sees it until an admin approves it, which clears the owner.
  ownerId         String?
  owner           User?        @relation("OwnedDrills", fields: [ownerId], references: [id], onDelete: Cascade)
  submittedById   String?
  submittedBy     User?        @relation("SubmittedDrills", fields: [submittedById], references: [id], onDelete: SetNull)
  // "" (added straight to the library) | PENDING | APPROVED | REJECTED
  reviewStatus    String       @default("")
  reviewNote      String       @default("")
  reviewedAt      DateTime?
  sports          Sport[]
  // Age/skill/focus/surface tags say where the drill fits; equipment tags
  // are what it requires. An empty age or surface list means "any".
  tags            Tag[]
  videos          DrillVideo[]
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
}

model DrillVideo {
  id        String @id @default(cuid())
  drillId   String
  drill     Drill  @relation(fields: [drillId], references: [id], onDelete: Cascade)
  url       String
  label     String @default("")
  sortOrder Int    @default(0)
}

model Team {
  id        String   @id @default(cuid())
  // Null only for rows created before accounts existed; the first account claims them.
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  sportId   String
  sport     Sport    @relation(fields: [sportId], references: [id])
  ageSlug   String
  skillSlug String   @default("")
  season    String   @default("")
  players   Player[]
  plans     Plan[]
  createdAt DateTime @default(now())
}

model Player {
  id        String  @id @default(cuid())
  teamId    String
  team      Team    @relation(fields: [teamId], references: [id], onDelete: Cascade)
  name      String
  // string[] of role slugs from the sport config, e.g. ["pitcher"]
  roles     Json
  active    Boolean @default(true)
  sortOrder Int     @default(0)
}

model Coach {
  id     String  @id @default(cuid())
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  name   String
  active Boolean @default(true)

  @@unique([userId, name])
}

model Location {
  id          String  @id @default(cuid())
  userId      String?
  user        User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  surfaceSlug String  @default("")

  @@unique([userId, name])
}

model Setting {
  key   String @id
  value String
}

model Plan {
  id          String   @id @default(cuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  sportId     String
  sport       Sport    @relation(fields: [sportId], references: [id])
  teamId      String?
  team        Team?    @relation(fields: [teamId], references: [id], onDelete: SetNull)
  date        String // YYYY-MM-DD
  startTime   String // HH:MM, 24h
  durationMin Int
  location    String
  teamLeader  String   @default("")
  seed        Int
  // PlanInput JSON (the form as submitted)
  input       Json
  // PlanItem[] JSON tree, edited as a whole in the plan editor
  items       Json
  showTimes   Boolean  @default(true)
  // string[] JSON of generator warnings shown in the editor
  warnings    Json     @default("[]")
  driveFileId String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
