# SQLite file for local/self-hosted use. For Postgres, change provider in prisma/schema.prisma
DATABASE_URL="file:./dev.db"

# Hosted deploys: password prompt for the whole app (leave unset locally)
APP_PASSWORD=""

# Auth.js (required only for "Save to Google Drive")
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-me-to-a-long-random-string"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
