# SQLite file for local/self-hosted use. For Postgres, change provider in prisma/schema.prisma
DATABASE_URL="file:./dev.db"

# The app's public URL. Login cookies are marked Secure when it starts with https://
NEXTAUTH_URL="http://localhost:3000"

# Coach accounts (all optional)
# ADMIN_EMAILS="you@example.com,assistant@example.com"
# SIGNUP_CODE="pick-a-code-for-your-coaches"
# SEED_ADMIN_EMAIL=""
# SEED_ADMIN_PASSWORD=""

# Auth.js (required only for "Save to Google Drive")
NEXTAUTH_SECRET="change-me-to-a-long-random-string"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
